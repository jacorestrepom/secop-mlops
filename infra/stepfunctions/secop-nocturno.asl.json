{
  "Comment": "Flujo nocturno del recomendador SECOP: silver procesos (E3) → ganador (E6) → score.py en Fargate. Si cualquier paso falla tras sus reintentos, termina en Falla y no publica (la API sigue con la versión anterior). Los valores ${...} se reemplazan al desplegar (README).",
  "StartAt": "SilverProcesos",
  "TimeoutSeconds": 10800,
  "States": {
    "SilverProcesos": {
      "Type": "Task",
      "Comment": "Reescribe secop_silver.procesos desde bronze (deja estado preliminar y sin sector_entidad).",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": { "JobName": "secop-silver-procesos" },
      "ResultPath": "$.silver_procesos",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 120, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Falla" }],
      "Next": "SilverGanador"
    },
    "SilverGanador": {
      "Type": "Task",
      "Comment": "Completa ganador, estado, sector_entidad y n_proponentes. Debe correr después de E3.",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": { "JobName": "secop-silver-ganador" },
      "ResultPath": "$.silver_ganador",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 120, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Falla" }],
      "Next": "Score"
    },
    "Score": {
      "Type": "Task",
      "Comment": "jobs/score.py (fecha_corte = hoy en Bogotá). Sale con 2 si silver no está fresco y con 1 si falla: en los dos casos no publica.",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${CLUSTER_ARN}",
        "TaskDefinition": "${TASK_DEFINITION_ARN}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${SUBNETS},
            "SecurityGroups": ["${SG_JOBS}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "PropagateTags": "TASK_DEFINITION"
      },
      "ResultPath": "$.score",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 300, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Falla" }],
      "Next": "Publicado"
    },
    "Publicado": { "Type": "Succeed" },
    "Falla": {
      "Type": "Fail",
      "Error": "SecopNocturnoFallo",
      "Cause": "Un paso falló tras sus reintentos: no se publicó nada y la API sigue con la versión anterior."
    }
  }
}
